{
	"name": "file",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_transform",
						"type": "DatasetReference"
					},
					"name": "source"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_report",
						"type": "DatasetReference"
					},
					"name": "sink"
				},
				{
					"dataset": {
						"referenceName": "ds_report_F",
						"type": "DatasetReference"
					},
					"name": "sinkFinance"
				}
			],
			"transformations": [
				{
					"name": "select"
				},
				{
					"name": "split"
				},
				{
					"name": "aggregate"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          employee_id as integer,",
				"          employee_name as string,",
				"          department as string,",
				"          state as string,",
				"          salary as integer,",
				"          age as integer,",
				"          bonus as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> source",
				"source select(mapColumn(",
				"          employee_id,",
				"          department,",
				"          state,",
				"          salary,",
				"          age,",
				"          bonus",
				"     ),",
				"     partitionBy('hash', 1),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select",
				"select split(department==\"Marketing\",",
				"     department==\"Finance\",",
				"     department==\"HR\",",
				"     disjoint: false,",
				"     partitionBy('hash', 1)) ~> split@(Marketing, Finance, HR, otherdepartment)",
				"split@Marketing aggregate(groupBy(state),",
				"     bonus = sum(bonus),",
				"     partitionBy('hash', 1)) ~> aggregate",
				"split@Finance aggregate(groupBy(state),",
				"     bonus = sum(bonus),",
				"     partitionBy('hash', 1)) ~> aggregate1",
				"aggregate sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sinkFinance"
			]
		}
	}
}